# ALOS 2.0 — Server Environment Variables
# Copy to .env and fill in real values for production

# Required: JWT signing secret (generate with: openssl rand -hex 32)
ALOS_SECRET_KEY=change-me-to-a-random-64-char-string

# Optional: default admin password (only used on first boot)
ALOS_ADMIN_PASSWORD=learner123

# Optional: bind address/port
ALOS_HOST=127.0.0.1
ALOS_PORT=8000

# Optional: database path
ALOS_DB_PATH=database/alos.db

# Optional: RUST_LOG level
RUST_LOG=info